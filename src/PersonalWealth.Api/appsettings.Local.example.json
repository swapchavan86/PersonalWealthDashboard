{
  "ConnectionStrings": {
    "Default": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=PersonalWealthDashboard;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
  },
  "DocumentStorage": {
    "RootPath": "data/documents",
    "IncomingFolder": "incoming",
    "ProcessedFolder": "processed",
    "FailedFolder": "failed",
    "ArchiveFolder": "archive"
  },
  "OutboxPublisher": {
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 30
  }
}
